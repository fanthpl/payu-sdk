{
    "name": "@fanth/payu-sdk",
    "version": "0.1.6",
    "description": "TypeScript SDK for the PayU REST API",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "packageManager": "pnpm@11.17.0",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fanthpl/payu-sdk.git"
    },
    "scripts": {
        "build": "tsup && tsc --emitDeclarationOnly",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "pnpm build",
        "prod": "cross-env NODE_ENV=production tsx .",
        "dev": "tsx .",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.1.1",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "axios": "^1.18.1"
    }
}
